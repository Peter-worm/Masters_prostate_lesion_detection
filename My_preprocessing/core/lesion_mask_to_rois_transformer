from scipy import ndimage
import numpy as np

def lesion_mask_to_rois(mask):
    """
    Convert binary lesion mask into MDT bounding boxes.
    Output:
    [
      [class_id, x1,y1,z1,x2,y2,z2],
      ...
    ]
    """

    labeled, n = ndimage.label(mask > 0)

    rois = []

    for i in range(1, n+1):

        coords = np.where(labeled == i)

        if len(coords[0]) == 0:
            continue

        x1 = coords[0].min()
        y1 = coords[1].min()
        z1 = coords[2].min()

        x2 = coords[0].max()
        y2 = coords[1].max()
        z2 = coords[2].max()

        rois.append([
            1,       # lesion class
            x1, y1, z1,
            x2, y2, z2
        ])

    return np.array(rois, dtype=np.float32)